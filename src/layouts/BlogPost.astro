---
import BlogPublishShell from "../components/blog/BlogPublishShell.astro";
import BlogOutline from "../components/blog/BlogOutline.astro";
import BaseHead from "../components/global/BaseHead.astro";
import { Image } from "astro:assets";
import { getHeroImage } from "../utils/heroImage";
import { SEO } from "astro-seo";

declare global {
  interface Window {
    dataLayer: unknown[];
    gtag: (...args: unknown[]) => void;
  }
}

export interface Props {
  content: {
    title: string;
    description: string;
    pubDate?: string;
    updatedDate?: string;
    heroImage?: string;
  };
}

const {
  content: { title, description, pubDate, updatedDate, heroImage },
} = Astro.props;

const modules = import.meta.glob<{ frontmatter: Record<string, string> }>(
  "../pages/blog/*.{md,mdx}",
  { eager: true }
);

const posts = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path.replace(/^.*\/([^/]+)\.(md|mdx)$/, "$1");
    return {
      title: mod.frontmatter.title,
      url: `/blog/${slug}`,
      pubDate: mod.frontmatter.pubDate,
    };
  })
  .sort(
    (a, b) =>
      new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf()
  );

const heroSrc = heroImage ? getHeroImage(heroImage) : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title,
          type: "article",
          image: "https://charafmrah.com/thumbnail.jpg",
        },
      }}
      twitter={{
        creator: "@charafmrah",
      }}
    />
  </head>

  <body class="m-0 bg-publish-canvas font-Inter text-fg-subtle">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-59JLRZ4JB2"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-59JLRZ4JB2");
    </script>

    <BlogPublishShell posts={posts} currentUrl={Astro.url.pathname} pageLabel={title}>
      <main class="min-w-0 flex-1 border-r border-black/10 min-[1920px]:pl-2">
        <article
          id="single-article"
          class="publish-article mx-auto max-w-[min(100%,42rem)] px-5 py-10 lg:px-10 lg:py-14 min-[1920px]:px-14"
        >
          <header class="mb-10 border-b border-black/10 pb-8">
            <h1
              class="mb-4 font-SpaceGrotesk text-2xl font-semibold leading-tight tracking-tight text-fg md:text-3xl"
            >
              {title}
            </h1>
            <div
              class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-fg-subtle"
            >
              {
                pubDate && (
                  <time datetime={pubDate}>
                    {new Date(pubDate).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                )
              }
              {
                updatedDate && (
                  <span class="text-fg-subtle/80">
                    · Updated{" "}
                    <time datetime={updatedDate}>
                      {new Date(updatedDate).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  </span>
                )
              }
            </div>
            <p class="mt-4 text-base leading-relaxed text-fg-muted md:text-lg">
              {description}
            </p>
            {
              heroSrc && (
                <figure class="mt-8">
                  <Image
                    class="w-full rounded-md border border-black/10 shadow-sm"
                    src={heroSrc}
                    alt={title}
                  />
                </figure>
              )
            }
          </header>

          <div class="publish-prose">
            <slot />
          </div>
        </article>
      </main>
      <BlogOutline />
    </BlogPublishShell>

    <style is:global>
      .publish-article {
        --publish-border: rgb(20 26 25 / 0.12);
      }

      .publish-prose > :first-child {
        margin-top: 0;
      }

      .publish-prose h2 {
        @apply mb-3 mt-12 scroll-mt-24 font-SpaceGrotesk text-xl font-semibold tracking-tight text-fg md:text-2xl;
      }

      .publish-prose h3 {
        @apply mb-2 mt-8 scroll-mt-24 font-SpaceGrotesk text-lg font-semibold tracking-tight text-fg md:text-xl;
      }

      .publish-prose p {
        @apply mb-5 text-base leading-[1.75] text-fg-muted md:text-[1.0625rem];
      }

      .publish-prose ul {
        @apply mb-6 list-disc space-y-2 pl-6 text-fg-muted;
      }

      .publish-prose ol {
        @apply mb-6 list-decimal space-y-2 pl-6 text-fg-muted;
      }

      .publish-prose li {
        @apply pl-1 leading-[1.75];
      }

      .publish-prose a {
        @apply text-accent underline underline-offset-2 transition;
        text-decoration-color: rgb(114 47 55 / 0.35);
      }

      .publish-prose a:hover {
        text-decoration-color: var(--color-accent);
      }

      .publish-prose blockquote {
        @apply my-6 border-l-2 pl-4 text-fg-muted italic;
        border-left-color: rgb(114 47 55 / 0.45);
      }

      .publish-prose hr {
        @apply my-10 border-t border-black/10;
      }

      .publish-prose img {
        @apply my-6 max-w-full rounded-md border border-black/10;
      }

      .publish-prose pre {
        @apply my-6 overflow-x-auto rounded-lg border border-black/10 bg-[#1e1e1e] p-4 text-[0.8125rem] leading-relaxed text-[#e8e8e8];
      }

      .publish-prose pre code {
        @apply block bg-transparent p-0 font-mono text-[0.8125rem] text-inherit;
      }

      .publish-prose :not(pre) > code {
        @apply rounded bg-surface-card px-1.5 py-0.5 font-mono text-[0.85em] text-fg;
      }
    </style>

    <style>
      .bg-publish-canvas {
        background: #fcfcfa;
      }

      @media (prefers-color-scheme: dark) {
        .bg-publish-canvas {
          background: #1c1c1a;
        }
      }
    </style>
  </body>
</html>
