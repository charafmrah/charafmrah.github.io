---
import HomeSection from "../../layouts/HomeSection.astro";
---

<HomeSection id="skills" class="bg-section-skills">
  <div class="skills-card flex max-h-full max-w-3xl flex-col justify-center">
    <div class="tools">
      <div class="circle">
        <span class="red box"></span>
      </div>
      <div class="circle">
        <span class="yellow box"></span>
      </div>
      <div class="circle">
        <span class="green box"></span>
      </div>
    </div>
    <div
      class="flex flex-col justify-center gap-2 p-5 text-lg font-semibold md:text-xl"
    >
      <div>
        <h3>Programming languages:</h3>
        <p>JavaScript - Java - Python - PHP - Kotlin - TypeScript</p>
      </div>
      <div>
        <h3>Technologies:</h3>
        <p>
          React - HTML - CSS - Node.js - Next.js - Express.js - WordPress -
          Android SDK - Flutter - Git - MySQL - SQLite - Firebase - Linux
        </p>
      </div>
    </div>
  </div>
</HomeSection>

<style>
  .skills-card {
    position: relative;
    width: fit-content;
    height: fit-content;
    margin: 0 auto;
    box-shadow: 0 0 10px 0 var(--color-shadow-soft);
    background-color: var(--color-surface-card);
    border-radius: 8px;
    z-index: 1;
  }

  .tools {
    display: flex;
    align-items: center;
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
  }

  .circle {
    padding: 0 4px;
  }

  .box {
    display: inline-block;
    align-items: center;
    width: 10px;
    height: 10px;
    padding: 1px;
    border-radius: 50%;
  }

  .red {
    background-color: var(--color-traffic-red);
  }

  .yellow {
    background-color: var(--color-traffic-amber);
  }

  .green {
    background-color: var(--color-traffic-green);
  }
</style>
