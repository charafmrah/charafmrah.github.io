---
import TypewriterText from "../../components/global/TypewriterText";
import HomeSection from "../../layouts/HomeSection.astro";
---

<HomeSection id="home" headerTheme="light">
  <div
    class="-mx-6 flex w-[calc(100%+3rem)] min-h-screen flex-col items-center justify-center overflow-hidden bg-surface-hero text-center text-fg"
  >
    <div>
      <h1
        class="mx-auto max-w-[min(90vw,36rem)] text-center text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold leading-tight tracking-tight text-fg lg:mb-6"
      >
        Hi! I'm Charaf Mrah
      </h1>
      <div class="mt-2 font-medium text-fg-muted md:text-lg">
        <TypewriterText
          text={[
            "Software Engineer",
            "Web Developer",
            "Full-Stack Developer",
          ]}
          client:load
        />
      </div>
      <div class="flex flex-col items-center justify-center lg:hidden">
        <div class="mt-20">
          <lottie-player
            src="/swipe-left.json"
            background="transparent"
            speed="1"
            style="height: 80px;"
            loop
            autoplay></lottie-player>
        </div>
      </div>
    </div>
  </div>
</HomeSection>
