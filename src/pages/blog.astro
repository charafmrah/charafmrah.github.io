---
import BlogPublishShell from "../components/blog/BlogPublishShell.astro";
import BaseHead from "../components/global/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { SEO } from "astro-seo";

declare global {
  interface Window {
    dataLayer: unknown[];
    gtag: (...args: unknown[]) => void;
  }
}

const modules = import.meta.glob<{ frontmatter: Record<string, string> }>(
  "./blog/*.{md,mdx}",
  { eager: true }
);

const posts = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path.replace(/^.*\/([^/]+)\.(md|mdx)$/, "$1");
    return {
      title: mod.frontmatter.title,
      url: `/blog/${slug}`,
      pubDate: mod.frontmatter.pubDate,
      description: mod.frontmatter.description,
    };
  })
  .sort(
    (a, b) =>
      new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf()
  );
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <SEO
      title="Blog — Charaf Mrah"
      description={SITE_DESCRIPTION}
      openGraph={{
        basic: {
          title: "Charaf Mrah — Blog",
          type: "website",
          image: "https://charafmrah.com/thumbnail.jpg",
        },
      }}
      twitter={{
        creator: "@charafmrah",
      }}
    />
  </head>

  <body class="m-0 bg-publish-canvas font-Inter text-fg-subtle">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-59JLRZ4JB2"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-59JLRZ4JB2");
    </script>

    <BlogPublishShell posts={posts} currentUrl="/blog" pageLabel="Blog">
      <main class="min-w-0 flex-1 min-[1920px]:pl-2">
        <div class="mx-auto max-w-[min(100%,42rem)] px-5 py-10 lg:px-10 lg:py-14 min-[1920px]:px-14">
          <header class="mb-12 border-b border-publish-border pb-8">
            <h1
              class="font-SpaceGrotesk text-2xl font-semibold tracking-tight text-fg md:text-3xl"
            >
              Blog
            </h1>
            <p class="mt-3 max-w-prose text-base leading-relaxed text-fg-muted">
              Notes and write-ups in a quiet, reading-first layout.
            </p>
          </header>

          <ul class="space-y-0 divide-y divide-publish-border border-t border-publish-border">
            {
              posts.map((post) => (
                <li>
                  <a
                    href={post.url}
                    rel="prefetch"
                    class="group flex flex-col gap-1 py-5 transition-colors hover:bg-publish-hover sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
                  >
                    <span class="font-medium text-fg group-hover:text-accent">
                      {post.title}
                    </span>
                    <time
                      class="shrink-0 font-mono text-xs text-fg-subtle"
                      datetime={post.pubDate}
                    >
                      {new Date(post.pubDate).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </main>
    </BlogPublishShell>

    <style>
      .bg-publish-canvas {
        background: #fcfcfa;
      }

      .divide-publish-border {
        border-color: rgb(20 26 25 / 0.1);
      }

      .border-publish-border {
        border-color: rgb(20 26 25 / 0.1);
      }

      .hover\:bg-publish-hover:hover {
        background: rgb(20 26 25 / 0.04);
      }

      @media (prefers-color-scheme: dark) {
        .bg-publish-canvas {
          background: #1c1c1a;
        }

        .hover\:bg-publish-hover:hover {
          background: rgb(255 255 255 / 0.04);
        }
      }
    </style>
  </body>
</html>
