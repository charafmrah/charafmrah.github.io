---
import Header from "../components/global/Header.astro";
import BaseHead from "../components/global/BaseHead.astro";
import { Image } from "astro:assets";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { SEO } from "astro-seo";
import { getHeroImage } from "../utils/heroImage";

declare global {
  interface Window {
    dataLayer: any[];
    gtag: (...args: any[]) => void;
  }
}

const modules = import.meta.glob<{ frontmatter: Record<string, string> }>(
  "./blog/*.{md,mdx}",
  { eager: true }
);

const posts = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path.replace(/^.*\/([^/]+)\.(md|mdx)$/, "$1");
    return {
      ...mod,
      url: `/blog/${slug}`,
      frontmatter: mod.frontmatter,
    };
  })
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf()
  );
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <SEO
      title="Charaf Mrah - Blog"
      description={SITE_DESCRIPTION}
      openGraph={{
        basic: {
          title: "Charaf Mrah",
          type: "website",
          image: "https://charafmrah.com/thumbnail.jpg",
        },
      }}
      twitter={{
        creator: "@charafmrah",
      }}
    />
  </head>

  <body data-nav="false" class="m-0 font-Inter text-fg-subtle">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-59JLRZ4JB2"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-59JLRZ4JB2");
    </script>

    <Header />

    <main
      role="main"
      class="relative z-[2] m-0 transform bg-surface bg-cover bg-center px-5 transition-all duration-500 ease-in-out"
    >
      <section class="flex w-full shrink-0 flex-col lg:flex-row lg:gap-40">
        <h1
          class="mt-40 text-4xl font-bold tracking-tighter text-fg lg:mt-32 lg:text-8xl"
        >
          Blog
        </h1>
        <div
          class="mt-8 mb-32 space-y-12 text-base text-zinc-800 lg:col-span-3 lg:mt-32"
        >
          {
            posts.map((post) => {
              const heroSrc = post.frontmatter.heroImage
                ? getHeroImage(post.frontmatter.heroImage)
                : undefined;
              return (
                <>
                  <article class="md:grid md:grid-cols-4 md:items-baseline md:gap-12">
                    <>
                      <div class="group relative flex flex-col items-start hover:cursor-pointer md:col-span-3">
                        <>
                          <a rel="prefetch" href={post.url}>
                            <h2 class="mt-0 text-2xl font-semibold tracking-tight text-fg">
                              {post.frontmatter.title}:
                            </h2>
                          </a>
                          {heroSrc && (
                            <Image
                              src={heroSrc}
                              alt={post.frontmatter.title}
                              class="relative z-10 mb-5 h-64 w-full rounded-lg object-cover shadow-lg"
                            />
                          )}
                        </>

                        <>
                          <p class="relative z-10 mt-2 mb-2 text-xl text-slate-600">
                            {post.frontmatter.description}
                          </p>
                          <a href={post.url}>
                            <div
                              aria-hidden="true"
                              class="relative z-10 mt-4 flex items-center text-sm font-medium text-fg transition group-hover:text-accent"
                            >
                              Read article
                              <svg
                                viewBox="0 0 16 16"
                                fill="none"
                                aria-hidden="true"
                                class="order-last ml-1 h-4 w-4 stroke-current transition group-hover:translate-x-6"
                              >
                                <path
                                  d="M6.75 5.75 9.25 8l-2.5 2.25"
                                  stroke-width="1.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </div>
                          </a>
                        </>
                      </div>
                      <time
                        class="relative z-10 order-first mt-1 mb-3 flex items-center text-base text-zinc-500 dark:text-zinc-400 md:block md:text-right"
                        datetime={post.frontmatter.pubDate}
                      >
                        {new Date(post.frontmatter.pubDate).toLocaleDateString(
                          "en-us",
                          {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                          }
                        )}
                      </time>
                    </>
                  </article>
                </>
              );
            })
          }
        </div>
      </section>
    </main>

    <style>
      main ul {
        list-style-type: none;
        padding: unset;
      }
      main ul li {
        display: flex;
      }
      main a {
        color: #000;
      }
      main ul li time {
        flex: 0 0 130px;
        font-style: italic;
        color: #595959;
      }
      main ul li a:visited {
        color: rgb(246, 120, 56);
      }
    </style>
  </body>
</html>
